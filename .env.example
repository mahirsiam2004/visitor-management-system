# =====================================================================
# SecureEntry — Visitor Management System  ·  Environment Template
# Copy this file to `.env.local` and fill in YOUR OWN values.
# NEVER commit a real `.env.local` — it is gitignored on purpose.
# =====================================================================

# Supabase project credentials (get these from your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (used for QR codes and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron job secret — set this in Vercel dashboard → Settings → Environment Variables
# The Vercel Cron runner will send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-random-secret-here
